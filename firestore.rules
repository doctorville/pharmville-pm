rules_version = '2';

// 팜빌 활성화 PM · Firestore 보안 규칙
// - 관리자가 등록(accounts)하고 '사용' 상태인 계정만 데이터 접근
// - 메일 인증(email_verified)을 마친 로그인만 인정
// - 수정 이력(history)은 추가만 가능, 수정·삭제 불가
service cloud.firestore {
  match /databases/{database}/documents {

    // 최고 관리자 — firebase-config.js의 APP.superAdmins와 같게 유지
    function SUPER_ADMINS() { return ['ojungin@mcircle.biz']; }

    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function myEmail() { return request.auth.token.email.lower(); }
    function acctPath() { return /databases/$(database)/documents/accounts/$(myEmail()); }
    function isSuper() { return signedIn() && myEmail() in SUPER_ADMINS(); }
    function isMember() { return isSuper() || (signedIn() && exists(acctPath()) && get(acctPath()).data.active == true); }
    function isAdmin() { return isSuper() || (isMember() && get(acctPath()).data.role == 'admin'); }
    function isDate(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }

    // 로그인 전 '등록 여부'만 확인 (메일을 정확히 알 때 1건 조회만 가능, 목록 조회 불가)
    match /registry/{email} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }

    // 계정 상세 (이름·소속·권한) — 관리자 또는 본인만
    match /accounts/{email} {
      allow get: if isAdmin() || (signedIn() && myEmail() == email);
      allow list, create, update, delete: if isAdmin();
    }

    match /projects/{id} {
      allow read, delete: if isMember();
      allow create, update: if isMember()
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && isDate(request.resource.data.start) && isDate(request.resource.data.due)
        && request.resource.data.start <= request.resource.data.due;
    }

    // 세부업무 목표일은 상위 프로젝트 기간 안에서만 허용
    match /tasks/{id} {
      function parent() { return get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data; }
      allow read, delete: if isMember();
      allow create, update: if isMember()
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && isDate(request.resource.data.due)
        && exists(/databases/$(database)/documents/projects/$(request.resource.data.projectId))
        && request.resource.data.due >= parent().start
        && request.resource.data.due <= parent().due;
    }

    match /history/{id} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.by == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
